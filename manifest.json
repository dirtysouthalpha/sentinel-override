{
  "manifest_version": 3,
  "name": "Sentinel Override",
  "version": "21.6.74",
  "description": "Universal browser automation agent \u2014 investigates, configures, and collaborates via Universal Agent Protocol",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "debugger",
    "webNavigation",
    "alarms",
    "notifications",
    "downloads",
    "contextMenus",
    "cookies",
    "proxy"
  ],
  "action": {
    "default_title": "Sentinel Override",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/shadow-intercept.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-agent": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Toggle agent start/stop"
    },
    "pause-agent": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Pause/resume running agent"
    },
    "turbo-mode": {
      "description": "Set speed to turbo (fast, no human-like delays)"
    },
    "normal-mode": {
      "description": "Set speed to normal (human-like delays)"
    },
    "stealth-mode": {
      "description": "Set speed to stealth (slow, maximum human-like randomness)"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Toggle Sentinel Override side panel"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Toggle Sentinel Override side panel"
    }
  }
}