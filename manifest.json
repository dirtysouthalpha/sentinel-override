{
  "manifest_version": 3,
  "name": "Sentinel Override",
  "version": "3.2.0",
  "description": "Professional browser automation agent — investigate, configure, and troubleshoot the web",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "storage",
    "debugger",
    "webNavigation",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "Sentinel Override",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "background": {
    "service_worker": "background/index.js", "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shadow-intercept.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
