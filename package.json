{
  "name": "sentinel-override",
  "version": "21.6.76",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js --forceExit",
    "test:coverage": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js --coverage",
    "test:quick": "node --experimental-vm-modules --no-warnings ./node_modules/jest/bin/jest.js --forceExit --onlyChanged",
    "test:all": "npm test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:web": "node scripts/check-web-dashboards.cjs && node scripts/check-html-injection.cjs",
    "test:contract": "node scripts/check-contract.cjs",
    "routes:manifest": "node scripts/generate-route-manifest.cjs",
    "routes:check": "node scripts/generate-route-manifest.cjs --check",
    "check": "npm run lint && npm run test:web && npm run routes:check && npm run test:contract && npm test && npm run build",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/preset-env": "^7.29.5",
    "@eslint/js": "^9.39.4",
    "archiver": "^6.0.2",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "linkedom": "^0.18.12"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  }
}