/**
 * System Health Store for Agent Zero - Direct API Version
 *
 * Uses direct REST endpoint without CSRF requirements
 */

import { createStore } from "/js/AlpineStore.js";

const model = {
  // State
  vram: 0,
  vramPercent: 0,
  vramThreshold: 3200,
  activeWorkers: 0,
  maxWorkers: 4,
  cacheHitRate: 0,
  cacheHits: 0,
  cacheMisses: 0,
  cacheSize: 0,
  lastUpdate: null,
  isConnected: false,
  error: null,

  /**
   * Initialize the system health store
   */
  async init() {
    try {
      // Initial fetch
      await this.fetchSystemHealthData();
      
      // Set up periodic refresh every 5 seconds
      this._refreshInterval = setInterval(() => {
        this.fetchSystemHealthData();
      }, 5000);
      
    } catch (error) {
      console.error('Failed to initialize system health store:', error);
      this.isConnected = false;
      this.error = error.message || 'Connection failed';
    }
  },

  /**
   * Fetch system health data from direct endpoint
   */
  async fetchSystemHealthData() {
    try {
      const response = await fetch('/api/health_metrics');
      
      if (response.ok) {
        const data = await response.json();
        
        if (data.success && data.metrics) {
          const metrics = data.metrics;
          
          // Update metrics
          if (metrics.vram) {
            this.vram = metrics.vram.usage_mb;
            this.vramPercent = metrics.vram.usage_percent;
            this.vramThreshold = metrics.vram.threshold_mb;
          }
          
          if (metrics.workers) {
            this.activeWorkers = metrics.workers.active;
            this.maxWorkers = metrics.workers.max;
          }
          
          if (metrics.cache) {
            this.cacheHits = metrics.cache.hits;
            this.cacheMisses = metrics.cache.misses;
            this.cacheSize = metrics.cache.size;
            this.cacheHitRate = metrics.cache.hit_rate || 0;
          }
          
          this.isConnected = true;
          this.error = null;
          this.lastUpdate = new Date().toISOString();
        } else {
          this.isConnected = false;
          this.error = data.error || 'Invalid response';
        }
      } else {
        this.isConnected = false;
        this.error = 'HTTP ' + response.status + ': ' + response.statusText;
      }
      
    } catch (error) {
      console.error('Error fetching system health data:', error);
      this.isConnected = false;
      this.error = error.message || 'Failed to fetch data';
    }
  },

  /**
   * Get VRAM status class
   */
  getVramStatus() {
    if (this.vramPercent >= 80) return 'danger';
    if (this.vramPercent >= 50) return 'warning';
    return 'success';
  },

  /**
   * Get cache efficiency percentage
   */
  getCacheEfficiency() {
    const total = this.cacheHits + this.cacheMisses;
    if (total === 0) return 0;
    return Math.round((this.cacheHits / total) * 100);
  },

  /**
   * Check if system is healthy
   */
  isHealthy() {
    return this.isConnected && this.vramPercent < 80;
  },

  /**
   * Force refresh health data
   */
  async refresh() {
    await this.fetchSystemHealthData();
  },

  /**
   * Cleanup on store destruction
   */
  destroy() {
    if (this._refreshInterval) {
      clearInterval(this._refreshInterval);
    }
  }
};

// Create the Alpine store
const store = createStore('systemHealth', model);

export { store };
